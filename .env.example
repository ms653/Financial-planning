# Copy to .env.local for development, or to .env for docker compose.
# Never commit the filled-in version — .gitignore covers .env and .env.local.

# --- Database -----------------------------------------------------------------
# Inside docker compose the host is the service name `db`; from the host it's localhost.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-before-first-run
POSTGRES_DB=financial_planning
DATABASE_URL=postgresql://postgres:change-me-before-first-run@localhost:5432/financial_planning

# --- Auth ---------------------------------------------------------------------
# argon2id hash of the shared household passphrase. Generate with:
#   npm run passphrase:hash
# Single-quote it: the PHC string contains '$' characters.
# Under `docker compose`, that's all you need — Compose passes .env values straight
# through as container env vars. Running `npm run dev` directly against a `.env.local`
# is a different, confusing case: Next's own env loader runs values through
# dotenv-expand, which treats a bare `$word` as a variable reference and silently
# strips it even inside single quotes — an argon2id hash is full of exactly that shape
# ($argon2id$v=19$...), so it comes out mangled and login fails with "not a valid
# argon2id hash", not a hint that `$` was the problem. If you hit that doing local
# non-Docker dev, escape every `$` as `\$` in `.env.local` specifically (not needed in
# `.env` for Compose).
APP_PASSPHRASE_HASH='$argon2id$v=19$m=19456,t=2,p=1$REPLACE$REPLACE'

# HMAC key for session cookie signatures. At least 32 characters. Generate with:
#   openssl rand -base64 48
# Rotating this logs every device out.
SESSION_SECRET=

# Whether the session cookie carries the Secure flag.
# Leave unset: it defaults to on in production and off otherwise.
# Under `tailscale serve` the app itself sees plain HTTP even though the browser is on
# HTTPS, so this cannot be inferred from the request — hence the explicit switch.
# Set to false ONLY if you are deliberately serving over plain HTTP.
#COOKIE_SECURE=true

# --- Tailscale Serve ----------------------------------------------------------
# Comma-separated hostnames the browser will use to reach this app. Required once
# `tailscale serve` is in front of it: Next.js 14 compares the browser's Origin against
# the app's own Host when validating Server Action POSTs, and the reverse proxy makes
# those differ. Without this, every login is rejected as cross-origin.
# Example: laptop-name.tailnet-name.ts.net
SERVER_ACTIONS_ALLOWED_ORIGINS=

# --- Backup -------------------------------------------------------------------
# How old the last successful backup may get before the in-app indicator warns.
#BACKUP_STALE_AFTER_HOURS=48

# Where scripts/backup.sh writes encrypted dumps.
BACKUP_DIR=./backups

# Recipient for `age` encryption of the dump. Generate a keypair with:
#   age-keygen -o ~/.config/financial-planning/backup-key.txt
# then put the public key (age1...) here. The private key must live OFF this machine
# too, or an encrypted backup is useless after a disk failure.
BACKUP_AGE_RECIPIENT=

# Optional: rsync/rclone destination for off-machine copies. See docs/DEPLOYMENT.md.
#BACKUP_REMOTE=

# --- Market data (Phase 2) -----------------------------------------------------
# Free key (no card) from https://www.alphavantage.co/support/#api-key. Optional: the
# app works with holdings unpriced ("Price unavailable") if this is unset, the same
# posture as the account-sync provider in a later phase.
ALPHA_VANTAGE_API_KEY=

# How stale a cached quote may get before a page load triggers a refetch. Default 24h —
# ample for a household checking prices at most daily, and stays well inside Alpha
# Vantage's free-tier rate limit for a small number of distinct tickers.
#QUOTE_STALE_AFTER_HOURS=24

# --- Fundamentals data (Phase 4) ------------------------------------------------
# Free key (no card) from https://site.financialmodelingprep.com/register — 250
# requests/day. Optional: the stock analysis workbench works with a ticker's
# fundamentals unavailable if this is unset, same posture as ALPHA_VANTAGE_API_KEY.
FMP_API_KEY=

# How stale cached fundamentals may get before a lookup triggers a refetch. Default 24h.
#FUNDAMENTALS_STALE_AFTER_HOURS=24
